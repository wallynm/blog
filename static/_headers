# Cloudflare Pages reads this file from the root of the build output.
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# Vite fingerprints these filenames, so they can be cached indefinitely.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=604800

/css/*
  Cache-Control: public, max-age=604800

# These are prerendered to extensionless files, so the type has to be explicit.
/api/posts/count
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600

/api/posts/page/*
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600

/api/rss.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=3600
